  "authors": ["Alpha Candy Team"],
  "license": "Alpha Candy Non-Commercial License",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.alphacandy.fabric.AlphaCandyFabric"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "fabric-api": ">=${fabric_api_version}",
    "architectury": ">=${architectury_api_version}",
    "cobblemon": ">=1.8.1"
  }
}